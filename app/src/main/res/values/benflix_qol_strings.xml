    <!-- Late-night look -->
    <string name="benflix_late_night_look">Late-night look</string>
    <string name="benflix_fan_favourites">Fan favourite episodes</string>
    <string name="benflix_auto_mpv">Fancy subtitles player (test)</string>
    <string name="benflix_auto_mpv_on">Anime-style subtitles play in MPV so they look right. Falls back to the normal player if MPV has trouble</string>
    <string name="benflix_english_subs_only">Only English subtitles in menus</string>
    <string name="benflix_english_subs_only_on">Other languages are hidden from the subtitle menus. Nothing is removed from your files</string>
    <string name="benflix_english_subs_only_off">Off: every subtitle language shows</string>
    <string name="benflix_auto_mpv_off">Off: everything plays in the normal player</string>
    <string name="benflix_content_issue">This video has a problem and couldn\'t play. Try another version, or tell Ben</string>
    <string name="benflix_late_night_look_on">Menus dim a little at night (not the movie itself)</string>
    <string name="benflix_late_night_look_off">Off</string>
    <string name="benflix_christmas_look">Christmas look</string>
    <string name="benflix_christmas_look_on">In December, until New Year\'s: the Christmas room on Who\'s watching, with the tree, the train and the parade past the window</string>
    <string name="benflix_christmas_look_off">Off this year</string>
    <string name="benflix_popcorn_look">Popcorn Day look</string>
    <string name="benflix_popcorn_look_on">19 January: the popcorn cart room on Who\'s watching, a movie snack on every door, and butter yellow and cinema red colours (Kids too)</string>
    <string name="benflix_popcorn_look_off">Off this year</string>
    <string name="benflix_thanksgiving_look">Thanksgiving look</string>
    <string name="benflix_thanksgiving_look_on">16 to 30 November: the feast table on Who\'s watching, harvest charms on the doors, and pumpkin orange and harvest brown colours</string>
    <string name="benflix_thanksgiving_look_off">Off this year</string>
    <string name="benflix_valentines_look">Valentine\'s look</string>
    <string name="benflix_valentines_look_on">1 to 14 February: a table for two on Who\'s watching, love tokens on the doors, and rose red and wine colours</string>
    <string name="benflix_valentines_look_off">Off this year</string>
    <string name="benflix_new_year_look">New Year\'s look</string>
    <string name="benflix_new_year_look_on">27 December to 1 January: the party room on Who\'s watching with a midnight countdown, party charms on the doors, and champagne gold and midnight blue colours</string>
    <string name="benflix_new_year_look_off">Off this year</string>
    <string name="benflix_easter_look">Easter look</string>
    <string name="benflix_easter_look_on">Monday to Easter Sunday: the spring room with the egg tree and the pet rabbit on Who\'s watching, Easter tree charms on the doors, lilac and meadow green colours, and an egg hunt on Easter Sunday</string>
    <string name="benflix_easter_look_off">Off this year</string>
    <string name="benflix_earth_day_look">Earth Day look</string>
    <string name="benflix_earth_day_look_on">Earth week, 22 to 28 April: the plant corner on Who\'s watching, a living thing on each door, and leaf green and ocean blue colours (Kids too)</string>
    <string name="benflix_earth_day_look_off">Off this year</string>
    <string name="benflix_july_look">4th of July look</string>
    <string name="benflix_july_look_on">1 to 4 July: the cookout room on Who\'s watching with fireworks on the night of the 4th, summer things on the doors, and flag red and navy colours</string>
    <string name="benflix_july_look_off">Off this year</string>
    <string name="benflix_star_wars_look">Star Wars Day look</string>
    <string name="benflix_star_wars_look_on">4 May: the desert home on Who\'s watching, the opening crawl, galaxy moments on the doors, dark side red and black colours, and a Star Wars row on Movies</string>
    <string name="benflix_star_wars_look_off">Off this year</string>
    <string name="benflix_star_wars_side">Star Wars Day side</string>
    <string-array name="benflix_star_wars_sides">
        <item>Light side: blue laser swords</item>
        <item>Dark side: red laser swords</item>
    </string-array>
