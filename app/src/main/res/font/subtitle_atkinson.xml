<?xml version="1.0" encoding="utf-8"?>
<!-- Benflix standard subtitle font: Atkinson Hyperlegible (Braille Institute, SIL Open Font License 1.1,
     see assets/font-atkinson/OFL.txt). Italic files are here so <i> lines in subtitles get real italics. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/subtitle_atkinson_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/subtitle_atkinson_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/subtitle_atkinson_italic" android:fontStyle="italic" android:fontWeight="400"
        app:font="@font/subtitle_atkinson_italic" app:fontStyle="italic" app:fontWeight="400" />
    <font android:font="@font/subtitle_atkinson_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/subtitle_atkinson_bold" app:fontStyle="normal" app:fontWeight="700" />
    <font android:font="@font/subtitle_atkinson_bolditalic" android:fontStyle="italic" android:fontWeight="700"
        app:font="@font/subtitle_atkinson_bolditalic" app:fontStyle="italic" app:fontWeight="700" />
</font-family>
